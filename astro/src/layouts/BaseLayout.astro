---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Shubhang Mall — Software Engineer and Developer",
  image = "/assets/profile.jpeg",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://shubhangmall.com").toString();
const imageUrl = new URL(image, Astro.site ?? "https://shubhangmall.com").toString();

const navigation = [
  { label: "Work", href: "/#all-projects" },
  { label: "AI Lab", href: "/ai-lab/" },
  { label: "Notes", href: "/notes/" },
  { label: "About", href: "/about/" },
];

const externalLinks = [
  { label: "GitHub", href: "https://github.com/shubhangmall" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/shubhangmall/" },
  { label: "Resume", href: "https://drive.google.com/file/d/1_N-tTXATqUPkFXb7LZiTYhWtppFGP16u/view?usp=sharing" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shubhang Mall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Shubhang Mall home">SM<span>.</span></a>
      <nav aria-label="Primary navigation">
        <ul class="nav-list">
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="External links">
        <ul class="external-list">
          {externalLinks.map((item) => (
            <li><a href={item.href} target="_blank" rel="noreferrer">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <slot />
  </body>
</html>
