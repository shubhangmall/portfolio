---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import RunInspector from "../components/RunInspector";
import { SystemCarousel } from "../components/LabPatterns";
import { labTraces } from "../lib/ai-lab";
import "../styles/global.css";

const aiProjectSlugs = ["deep-research", "career-chatbot", "personal-sidekick", "financial-researcher", "engineering-team", "stock-picker", "agent-creator"];
const projects = await getCollection("projects");
const aiProjects = aiProjectSlugs
  .map((slug) => projects.find((project) => project.data.slug === slug))
  .filter((project): project is (typeof projects)[number] => Boolean(project));

const topologyLabels: Record<string, string> = {
  "deep-research": "plan → concurrent search → evidence → writer",
  "career-chatbot": "retrieve → rerank → context → grounded answer",
  "personal-sidekick": "graph state → tools → evaluator → retry",
  "financial-researcher": "sequential researcher → analyst",
  "engineering-team": "lead → backend/frontend → test",
  "stock-picker": "manager → delegated agents → memory",
  "agent-creator": "generate → register → collaborate → trust boundary",
};
---

<BaseLayout title="AI Engineering Lab — Shubhang Mall" description="A zero-cost AI Engineering Lab showing replayable execution traces, retrieval, orchestration, structured outputs, and trust boundaries across independent agent systems.">
  <main>
    <section class="ai-lab-intro" aria-labelledby="ai-lab-title">
      <p class="eyebrow">AI Engineering Lab · execution inspector</p>
      <h1 id="ai-lab-title">Applied AI, made observable.</h1>
      <p class="hero-copy">Seven independent experiments, presented as systems rather than interchangeable chat windows: orchestration, retrieval, structured outputs, state transitions, evidence, streaming, and trust boundaries.</p>
      <div class="lab-status-row"><span class="mode-badge">● replay by default</span><span>zero API cost · deterministic fixtures · no credentials</span></div>
      <a class="text-link" href="/#all-projects">Browse the full work archive</a>
    </section>

    <section class="ai-lab-section" aria-labelledby="ai-projects-title">
      <div class="section-heading"><div><p class="section-kicker">Compact system index</p><h2 id="ai-projects-title">Seven systems, seven shapes</h2></div><p>{aiProjects.length} replayable experiments</p></div>
      <div class="ai-system-index">
        {aiProjects.map((project) => {
          const trace = labTraces.find((candidate) => candidate.slug === project.data.slug);
          return <article class="ai-system-row"><span class="ai-system-row__number">{String(aiProjects.indexOf(project) + 1).padStart(2, "0")}</span><div><span class="project-meta">{project.data.category} · replayable</span><h3>{project.data.portfolioTitle ?? project.data.title}</h3><p>{topologyLabels[project.data.slug] ?? project.data.summary}</p></div><div class="ai-system-row__meta"><span>{trace ? `${trace.events.length} observable events` : "documented system"}</span><a class="text-link" href={`/work/${project.data.slug}/`}>Inspect ↗</a></div></article>;
        })}
      </div>
    </section>

    <section class="ai-lab-section" aria-labelledby="replay-title">
      <div class="section-heading"><div><p class="section-kicker">Flagship replay</p><h2 id="replay-title">Deep Research, step by step</h2></div><p>Replay · no network request</p></div>
      {labTraces[0] && <RunInspector trace={labTraces[0]} client:load />}
    </section>

    <section class="ai-lab-section ai-lab-secondary" aria-labelledby="system-index-title">
      <div class="section-heading"><div><p class="section-kicker">Architecture explorer</p><h2 id="system-index-title">Inspect the execution signatures</h2></div><p>Cycle through the normalized presentation boundary.</p></div>
      <SystemCarousel traces={labTraces} client:load />
    </section>

    <details class="ai-lab-section ai-lab-secondary ai-lab-details" aria-labelledby="workflow-title">
      <summary class="section-heading"><h2 id="workflow-title">Technical notes: request to trace</h2><p>Open for the shared presentation boundary</p></summary>
      <p class="ai-lab-detail-kicker">Reusable agent workflow</p>
      <ol class="workflow-flow" aria-label="Agent workflow from request to traceable result">
        <li class="flow-node"><span class="flow-node__number">01</span><strong>Frame</strong><span>Bound the task</span><small>orchestrator</small></li>
        <li class="flow-connector" aria-hidden="true"><span>request</span></li>
        <li class="flow-node flow-node--accent"><span class="flow-node__number">02</span><strong>Gather</strong><span>Retrieve evidence</span><small>tools</small></li>
        <li class="flow-connector" aria-hidden="true"><span>context</span></li>
        <li class="flow-node"><span class="flow-node__number">03</span><strong>Compose</strong><span>Synthesize output</span><small>model</small></li>
        <li class="flow-connector" aria-hidden="true"><span>draft</span></li>
        <li class="flow-node flow-node--accent"><span class="flow-node__number">04</span><strong>Verify</strong><span>Trace the result</span><small>trace</small></li>
      </ol>
      <ol class="workflow-details">
        <li><strong>Frame</strong><p>Translate the request into a bounded task with an expected output.</p></li>
        <li><strong>Gather</strong><p>Call the relevant search or project tool and collect supporting context.</p></li>
        <li><strong>Compose</strong><p>Use the model to synthesize an answer or artifact from the retrieved context.</p></li>
        <li><strong>Verify</strong><p>Return the result with enough source information for a person or future agent to inspect.</p></li>
      </ol>
      <p class="workflow-note">The tool boundary is intentionally separate from the interface, leaving room for a future web agent or Portfolio MCP server to use the same portfolio data layer.</p>
    </details>

    <section class="ai-lab-section" aria-labelledby="code-example-title">
      <div class="section-heading"><h2 id="code-example-title">A grounded tool call</h2><p>Illustrative TypeScript</p></div>
      <div class="code-block" data-code-block>
        <div class="code-block__header"><span>portfolio-search.ts · illustrative</span><button type="button" class="code-block__copy" data-copy-code aria-describedby="copy-status">Copy</button></div>
        <pre><code data-code-content>const context = await searchPortfolio(question, 4);

const answer = await compose(question, context);</code></pre>
        <span class="sr-only" id="copy-status" role="status" aria-live="polite"></span>
      </div>
      <p class="code-note">This is a visual example of the portfolio tool boundary, not a new endpoint or executable example.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const codeBlock = document.querySelector("[data-code-block]");
  const copyButton = codeBlock?.querySelector("[data-copy-code]");
  const codeContent = codeBlock?.querySelector("[data-code-content]");
  const copyStatus = codeBlock?.querySelector("#copy-status");

  copyButton?.addEventListener("click", async () => {
    if (!codeContent || !copyStatus) return;
    try {
      await navigator.clipboard.writeText(codeContent.textContent ?? "");
      copyButton.textContent = "Copied";
      copyStatus.textContent = "Code copied to clipboard.";
      window.setTimeout(() => { copyButton.textContent = "Copy"; }, 1600);
    } catch {
      copyStatus.textContent = "Copy is unavailable in this browser.";
    }
  });
</script>
