---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PromptBar from "../components/PromptBar";
import { identity } from "../data/site";
import "../styles/global.css";

export const prerender = true;

const selectedSpecs = [
  { slug: "engineering-team", index: "01", capability: "Multi-agent orchestration", className: "selected-system--lead" },
  { slug: "deep-research", index: "02", capability: "Research / retrieval pipeline", className: "selected-system--research" },
  { slug: "career-chatbot", index: "03", capability: "Context + tool calling", className: "selected-system--chatbot" },
] as const;
const allProjects = await getCollection("projects");
const selectedProjects = selectedSpecs
  .map((spec) => ({ ...spec, project: allProjects.find((project) => project.data.slug === spec.slug) }))
  .filter((item): item is (typeof selectedSpecs)[number] & { project: (typeof allProjects)[number] } => Boolean(item.project));
const selectedSlugs: string[] = selectedSpecs.map(({ slug }) => slug);
const remainingProjects = allProjects.filter((project) => !selectedSlugs.includes(project.data.slug));

const title = `${identity.name} — ${identity.headline}`;
---

<BaseLayout title={title} description={identity.intro}>
  <main id="main-content">
    <section class="hero" id="about" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">Software engineer · AI systems · San Francisco Bay Area</p>
        <h1 id="hero-title">I build software that makes complex systems legible.</h1>
        <p class="hero-copy">I’m {identity.name}, a software engineer moving between production applications and applied AI. This is a working archive of the systems, decisions, and experiments behind that practice.</p>
        <div class="hero-aside"><span>Currently</span><strong>Turning agent workflows into inspectable products.</strong><span>8+ years across full-stack, cloud, and AI engineering.</span></div>
        <div class="hero-links">
          <a class="button-link button-link--accent" href="#featured-work">Explore selected work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="mailto:shubhangmall@hotmail.com">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
        <PromptBar client:visible demo={false} />
      </div>
      <div class="hero-portrait-wrap"><span class="hero-portrait-label">01 / profile</span><img class="hero-image" src={identity.profileImage.src} alt={identity.profileImage.alt} width="2316" height="2316" loading="eager" fetchpriority="high" decoding="async" /><span class="hero-portrait-caption">Software → AI engineering</span></div>
    </section>

    <section id="featured-work" class="selected-systems" aria-labelledby="featured-work-title">
      <div class="section-heading">
        <div><p class="section-kicker">01 / selected work</p><h2 id="featured-work-title">Systems built to be inspected.</h2></div>
        <a class="section-route" href="/ai-lab/">Explore AI Lab <span aria-hidden="true">→</span></a>
      </div>
      <div class="selected-system-list">
        {selectedProjects.map(({ project, index, capability, className }) => (
          <a class={`selected-system ${className}`} href={`/work/${project.data.slug}/`} aria-label={`View ${project.data.portfolioTitle ?? project.data.title} project`}>
            <span class="selected-system__number">{index}</span>
            <div class="selected-system__body"><div class="selected-system__meta"><span>{capability}</span><span>{project.data.category}</span></div><h3>{project.data.portfolioTitle ?? project.data.title}</h3><p>{project.data.summary}</p><footer><span>{project.data.technologies.slice(0, 4).join(" · ")}</span><span aria-hidden="true">↗</span></footer></div>
            {project.data.image && <img src={project.data.image} alt="" width="1311" height="771" loading="lazy" decoding="async" />}
          </a>
        ))}
      </div>
    </section>

    <section class="all-work" id="all-projects" aria-labelledby="all-projects-title">
      <div class="section-heading">
        <div><p class="section-kicker">02 / archive</p><h2 id="all-projects-title">The wider archive.</h2></div>
        <p>{remainingProjects.length} smaller experiments, studies, and systems.</p>
      </div>
      <ul class="project-index" aria-label="More project case studies">
        {remainingProjects.map((project) => (
          <li>
            <a class="project-index__row" href={`/work/${project.data.slug}/`} aria-label={`View ${project.data.portfolioTitle ?? project.data.title} project`}>
              <span class="project-index__number" aria-hidden="true">↳</span>
              <span class="project-index__title"><span class="project-meta">{project.data.category}</span><strong>{project.data.portfolioTitle ?? project.data.title}</strong></span>
              <span class="project-index__summary">{project.data.summary}</span>
              <span class="project-index__tools">{project.data.technologies.slice(0, 3).join(" · ")}</span>
              <span class="project-index__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-contact" aria-labelledby="home-contact-title">
      <p class="section-kicker">03 / open channel</p>
      <div><h2 id="home-contact-title">Have a hard system to make clearer?</h2><a class="button-link button-link--accent" href="mailto:shubhangmall@hotmail.com">Start a conversation <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
</BaseLayout>
