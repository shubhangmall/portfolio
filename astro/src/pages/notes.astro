---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const notes = await getCollection("notes");
const noteTopics = ["All", ...new Set(notes.map((note) => note.data.topic))];
---

<BaseLayout title="Notes — Shubhang Mall" description="Short technical writing drawn from AI systems and software projects I have actually built. These entries are outlined now; full notes will be published as they are written.">
  <main id="main-content" class="notes-page">
    <section class="notes-intro" aria-labelledby="notes-title" data-reveal>
      <p class="eyebrow">00 / Notes · engineering notebook</p>
      <h1 id="notes-title">Systems, decisions, and working notes.</h1>
      <p class="hero-copy">Short technical writing drawn from AI systems and software projects I have actually built. These entries are outlined now; full notes will be published as they are written.</p>
      <a class="text-link" href="/">Return home</a>
    </section>

    <section class="notes-feed" aria-labelledby="notes-feed-title" data-reveal>
      <div class="section-heading"><div><p class="section-kicker">The notebook</p><h2 id="notes-feed-title">Drafts and upcoming notes</h2></div><span class="notes-count">{notes.length} entries</span></div>
      <div class="notes-toolbar" data-note-filter>
        <span>Browse by thread</span>
        <div class="filter-controls" role="group" aria-label="Filter notes by topic">
          {noteTopics.map((topic) => <button type="button" data-note-filter-button={topic.toLowerCase()} aria-controls="note-list" aria-pressed={topic === "All" ? "true" : "false"}>{topic}<span>{topic === "All" ? notes.length : notes.filter((note) => note.data.topic === topic).length}</span></button>)}
        </div>
        <span id="note-filter-status" class="sr-only" role="status" aria-live="polite"></span>
      </div>
      <div class="notes-list" id="note-list">
        {notes.map((note, index) => (
          <article class="note-entry" data-note-item data-note-topic={note.data.topic.toLowerCase()}>
            <div class="note-entry__index">{String(index + 1).padStart(2, "0")}</div>
            <div class="note-entry__body">
              <div class="note-entry__meta"><span>{note.data.status}</span><span>{note.data.topic}</span>{note.data.date && <time datetime={note.data.date.toISOString()}>{note.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>}</div>
              <h3>{note.data.title}</h3>
              <p>{note.data.description}</p>
              <div class="note-entry__footer"><div class="note-tags">{note.data.tags.map((tag) => <span>#{tag}</span>)}</div>{note.data.relatedProject && <a class="text-link" href={`/work/${note.data.relatedProject}/`}>Related project <span aria-hidden="true">→</span></a>}</div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const noteFilterRoot = document.querySelector("[data-note-filter]");
  const noteFilterButtons = Array.from(noteFilterRoot?.querySelectorAll<HTMLButtonElement>("[data-note-filter-button]") ?? []);
  const noteItems = Array.from(document.querySelectorAll<HTMLElement>("[data-note-item]"));
  const noteFilterStatus = document.querySelector("#note-filter-status");

  noteFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.noteFilterButton ?? "all";
      noteFilterButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      let visibleCount = 0;
      noteItems.forEach((item) => {
        const matches = filter === "all" || item.dataset.noteTopic === filter;
        item.hidden = !matches;
        if (matches) visibleCount += 1;
      });
      if (noteFilterStatus) noteFilterStatus.textContent = `${visibleCount} ${visibleCount === 1 ? "note" : "notes"} shown for ${filter === "all" ? "all topics" : filter}.`;
    });
  });
</script>
